TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=file:./data/db.sqlite
PORT=3000
# Set to "true" only when running without HTTPS (e.g. local dev, Portainer without TLS proxy).
# Otherwise auth and CSRF cookies will be secure-only and not transmitted over HTTP.
# INSECURE_COOKIES=false
# Optional: path for persisted auth secrets (Docker default: /data/secrets.json)
# SECRETS_FILE_PATH=/data/secrets.json
# Optional — if omitted, credentials are auto-generated on first run (see data/secrets.json)
# ADMIN_PASSWORD=your-strong-password-here
# JWT_SECRET=run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
